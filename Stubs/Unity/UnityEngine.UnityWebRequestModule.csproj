<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>UnityEngine.UnityWebRequestModule</AssemblyName>
    <RootNamespace>UnityEngine.Networking</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Unity engine modules ship as version 0.0.0.0 and are not strong-named -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- UnityWebRequestAsyncOperation erbt von AsyncOperation (CoreModule) —
         exakt wie im echten Modul, damit die Metadaten-Referenzen stimmen. -->
    <ProjectReference Include="..\Unity.CoreModule\UnityEngine.CoreModule.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
